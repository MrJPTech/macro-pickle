# Google AI — Gemini (vision/OCR), Imagen (images), Veo (video), Nano Banana (face-lock refs)
GOOGLE_API_KEY=your-google-api-key

# fal.ai — Kling video generation + FLUX/Recraft/Ideogram/SD3.5 image models
FAL_KEY=your-fal-key

# --- Additional video-model providers (see `pnpm models providers`) ---
# The model registry (scripts/lib/models/) can route to first-party consoles.
# Each is OPTIONAL — only needed if you `pnpm models select` a model on it.

# BytePlus ModelArk (ByteDance) — cheapest Seedance 2.0 path (~$0.14/s vs fal ~$0.30/s).
# Console: https://console.byteplus.com/
BYTEPLUS_API_KEY=

# Runway (dev.runwayml.com) — Runway's own models only (Aleph 2.0 v2v, Act-Two, Gen-4.5).
# Console: https://dev.runwayml.com/
RUNWAY_API_KEY=

# Replicate — alternate host for Veo / PixVerse / LTX / MiniMax / Luma.
# Keys: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: where generated images and clips are written. Defaults to
# ./generated-images. Point it at a synced folder (iCloud / Drive / Dropbox) to
# review results on your phone. Machine-specific absolute path — set the real
# value in .env.local, not here.
# Example (Windows): C:\Users\you\iCloudDrive\macro-pickle-export
# Example (macOS):   /Users/you/Library/Mobile Documents/com~apple~CloudDocs/macro-pickle
MACRO_PICKLE_EXPORT_DIR=

# Optional: default output folder for Omni Flash video edits (pnpm omni) when
# --out isn't passed. Any local folder works. Falls back to
# MACRO_PICKLE_EXPORT_DIR/omni-clips, then ./omni-clips.
# Example (Windows): C:\Users\you\Pictures
MACRO_PICKLE_OMNI_DIR=

# Optional: where finalized/exported prompts are saved. Defaults to
# ./exported-prompts. Point it at a notes vault (Obsidian, Logseq, or any folder)
# to collect them there instead.
# Example (macOS): /Users/you/Documents/MyVault/Prompts
MACRO_PICKLE_PROMPT_VAULT=

# Optional: where brand profiles are loaded from. Defaults to content/brands.
# Point it at a private directory to keep client brands out of this repo.
MACRO_PICKLE_BRANDS_DIR=

# Optional: default --store dir for `pnpm rank-skus` / `pnpm gen-clips`.
# Expected layout: <dir>/manifest.json + <dir>/<category>/<sku>/gen5/
MACRO_PICKLE_STORE_DIR=

# Optional: Python interpreter for the OPTIONAL PaddleOCR sidecar (pnpm ocr,
# pnpm describe --paddle). Only needed if you opt into local OCR; install deps with
# `pip install -r scripts/py/requirements.txt`. Defaults to `python` on PATH.
# For the MCP server, set this in the Claude Desktop config `env` block, not just here.
# Example (Windows): C:\Users\you\envs\paddle\Scripts\python.exe
MACRO_PICKLE_PYTHON=

# Optional: if PaddleOCR errors at inference with a oneDNN/PIR NotImplementedError (some
# CPU paddlepaddle builds do), set this to 0. The sidecar already auto-falls-back, but
# this skips the wasted ~2x model load per image — recommended for bulk OCR on such builds.
MACRO_PICKLE_PADDLE_MKLDNN=
